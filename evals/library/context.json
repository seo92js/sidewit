{
  "name": "eval-library",
  "dialect": "postgresql",
  "timezone": "Asia/Tokyo",
  "definition": {
    "resources": [
      {
        "name": "members",
        "description": "도서관 회원",
        "fields": [
          {
            "name": "id",
            "type": "bigint"
          },
          {
            "name": "zone",
            "type": "text",
            "description": "거주 지역"
          },
          {
            "name": "name",
            "type": "text",
            "description": "회원 이름"
          }
        ]
      },
      {
        "name": "rentals",
        "description": "대여 결제",
        "fields": [
          {
            "name": "id",
            "type": "bigint"
          },
          {
            "name": "member_id",
            "type": "bigint"
          },
          {
            "name": "fee",
            "type": "numeric",
            "description": "실제 결제된 대여료"
          },
          {
            "name": "state",
            "type": "text",
            "description": "대여 상태"
          },
          {
            "name": "opened_at",
            "type": "timestamptz",
            "description": "대여 시작 시각. 대여 건수의 기간 기준."
          },
          {
            "name": "settled_at",
            "type": "timestamptz",
            "description": "결제 완료 시각. 대여료 합계의 기간 기준."
          }
        ]
      },
      {
        "name": "parcels",
        "description": "배송",
        "fields": [
          {
            "name": "id",
            "type": "bigint"
          },
          {
            "name": "rental_id",
            "type": "bigint"
          },
          {
            "name": "registered_at",
            "type": "timestamptz"
          },
          {
            "name": "sorted_at",
            "type": "timestamptz"
          },
          {
            "name": "handed_over_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "name": "reviews",
        "description": "회원이 작성한 리뷰",
        "fields": [
          {
            "name": "id",
            "type": "bigint",
            "primary_key": true,
            "nullable": false
          },
          {
            "name": "member_id",
            "type": "bigint",
            "nullable": false
          },
          {
            "name": "score",
            "type": "integer",
            "description": "1~5점 평점"
          },
          {
            "name": "created_at",
            "type": "timestamptz",
            "nullable": false
          },
          {
            "name": "updated_at",
            "type": "timestamptz",
            "nullable": false
          }
        ]
      }
    ],
    "relations": [
      {
        "from": "rentals.member_id",
        "to": "members.id"
      },
      {
        "from": "parcels.rental_id",
        "to": "rentals.id"
      },
      {
        "from": "reviews.member_id",
        "to": "members.id"
      }
    ],
    "rules": [
      {
        "id": "fee_total",
        "text": "대여료 합계는 state = 'SETTLED'인 rentals의 fee 합계이다."
      },
      {
        "id": "rental_count",
        "text": "대여 건수는 state = 'VOID'인 rentals를 제외한다."
      }
    ]
  }
}
