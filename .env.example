# Host directory for Contexts and Tools (JSON files). Back it up by copying it.
SIDEWIT_DATA_PATH=./data
SIDEWIT_API_PORT=8000
SIDEWIT_WEB_PORT=3000
# Web administrator. Defaults to admin/admin even when this file is not copied.
# Change both values before exposing the management UI outside localhost.
# Changes take effect after `docker compose up -d --wait api` recreates the API container.
SIDEWIT_ADMIN_USERNAME=admin
SIDEWIT_ADMIN_PASSWORD=admin
# Set true when serving the web UI over HTTPS.
SIDEWIT_ADMIN_COOKIE_SECURE=false
# Set to require `Authorization: Bearer <key>` on public /api/v1 routes except /health.
# This is the Sidewit API key, not an LLM provider key. Empty disables public /api/v1 authentication.
SIDEWIT_API_KEY=

# Optional MCP endpoint in the same API container, also proxied by the web container.
# Explicitly enabling MCP with an empty key allows unauthenticated MCP access.
SIDEWIT_MCP_ENABLED=false
SIDEWIT_MCP_KEY=
# For remote access, add the public Host header (JSON array); defaults allow loopback only.
SIDEWIT_MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*","[::1]","[::1]:*"]
# Only needed for clients sending an Origin header. This does not enable browser CORS.
SIDEWIT_MCP_ALLOWED_ORIGINS=[]

# LLM for /generate: provider is "openai" or "gemini"; model and the matching key are required.
SIDEWIT_LLM_PROVIDER=
SIDEWIT_LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Recent Generations kept in memory only (lost on restart).
SIDEWIT_GENERATION_HISTORY=200
